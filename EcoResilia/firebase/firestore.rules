rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function isOwner() { return authenticated() && resource.data.userId == request.auth.uid; }
    function validText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function validReport(data, reportId) {
      return data.keys().hasAll(['id','userId','category','description','zone','createdAtEpochMs'])
        && data.keys().hasOnly(['id','userId','category','description','zone','createdAtEpochMs'])
        && data.id == reportId
        && data.userId is string && authenticated() && data.userId == request.auth.uid
        && data.category in ['Huaico', 'Inundación', 'Derrumbe']
        && validText(data.description, 8, 500)
        && validText(data.zone, 2, 100)
        && data.createdAtEpochMs is int && data.createdAtEpochMs > 0;
    }
    match /communityReports/{reportId} {
      // La app realiza whereEqualTo("userId", uid). No feed público.
      allow get, list: if isOwner();
      allow create: if validReport(request.resource.data, reportId);
      allow update: if isOwner()
        && validReport(request.resource.data, reportId)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['category', 'description', 'zone']);
      allow delete: if isOwner();
    }
  }
}
